# Supabase — wajib. Ambil dari Project Settings → API di dashboard Supabase.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key

# Service-role key (bypass RLS) — WAJIB, server-only. JANGAN commit ke git.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# OpenRouter — untuk fitur OCR foto hasil lab. Server-only. JANGAN commit ke git.
OPENROUTER_API_KEY=your_openrouter_api_key
